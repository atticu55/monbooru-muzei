<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Server" app:iconSpaceReserved="false">

        <EditTextPreference
            app:key="serverUrl"
            app:title="Monbooru server URL"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"
            app:dialogTitle="Monbooru server URL" />

        <EditTextPreference
            app:key="apiToken"
            app:title="API token"
            app:summary="Bearer token from Monbooru Settings"
            app:iconSpaceReserved="false"
            app:dialogTitle="API token" />

        <EditTextPreference
            app:key="collection"
            app:title="Collection"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"
            app:dialogTitle="Collection name" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Refresh conditions" app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="onlyWifi"
            app:defaultValue="false"
            app:title="Only on unmetered network"
            app:summary="Skip refreshes on mobile data"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="requiresCharging"
            app:defaultValue="false"
            app:title="Only while charging"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="batteryNotLow"
            app:defaultValue="false"
            app:title="Only when battery is not low"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
